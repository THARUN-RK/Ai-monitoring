# ──────────────────────────────────────────────────
# NeuralWatch / CICADA – Environment Variables
# Copy this to .env for local development.
# Set each variable in the Render dashboard for production.
# ──────────────────────────────────────────────────

# API key used by the local collector to authenticate with the backend.
# Generate a strong random value for production (render.yaml uses generateValue).
AGENT_API_KEY=change-this-demo-key

# Database connection string.
# SQLite is fine for local dev and Render hobby tier.
# Switch to postgresql://user:pass@host/db for Render PostgreSQL.
DATABASE_URL=sqlite:///./cicada.db

# Comma-separated list of allowed CORS origins.
# Set to your Render frontend URL in production, e.g.:
#   ALLOWED_ORIGINS=https://neurawatch.onrender.com,http://localhost:5173
# Set to * to allow all origins (convenient for hackathon demos).
ALLOWED_ORIGINS=http://localhost:5173
